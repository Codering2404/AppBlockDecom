<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom|center_horizontal"
    android:background="@color/background"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="32dp">
    <View
        android:id="@+id/gradientView"
        android:background="@drawable/background_bottom_button_gradient"
        android:layout_width="0dp"
        android:layout_height="@dimen/bottom_button_margin"
        app:layout_constraintBottom_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_side_padding"
        android:paddingEnd="@dimen/screen_side_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <Button
            android:ellipsize="end"
            android:id="@+id/secondaryButton"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="66dp"
            android:layout_marginBottom="12dp"
            android:text="@string/blocking_new"
            android:maxLines="1"
            android:layout_marginStart="@dimen/activity_horizontal_margin"
            android:layout_marginEnd="8dp"
            app:autoSizeMaxTextSize="18sp"
            app:autoSizeMinTextSize="10sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/bottomButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginEnd="@dimen/activity_horizontal_margin"
            style="@style/AppTheme.SurfaceButton"/>
        <Button
            android:ellipsize="end"
            android:id="@+id/bottomButton"
            android:layout_width="0dp"
            android:layout_height="66dp"
            android:layout_marginBottom="12dp"
            android:text="@string/save"
            android:maxLines="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="@dimen/activity_horizontal_margin"
            app:autoSizeMaxTextSize="18sp"
            app:autoSizeMinTextSize="10sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/secondaryButton"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginStart="@dimen/activity_horizontal_margin"
            style="@style/AppTheme.AccentButton"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

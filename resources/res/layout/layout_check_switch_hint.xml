<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="bottom"
            android:id="@+id/viewContainer"
            android:background="@color/background"
            android:paddingBottom="24dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageButton
                android:textSize="16sp"
                android:layout_gravity="start"
                android:id="@+id/closeButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/close"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_close_accent"
                app:tint="@color/main_secondary"
                style="@style/Widget.AppCompat.ActionButton"/>
            <View
                android:background="@color/accent"
                android:layout_width="0dp"
                android:layout_height="1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:id="@+id/hintTextView"
                android:padding="16dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/hint_check_switch"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iconView"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/AppTheme.TextView.Body2.Secondary"/>
            <cz.mobilesoft.coreblock.view.badge.BadgeView
                android:id="@+id/iconView"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="@dimen/activity_horizontal_margin"
                app:badge_background="@color/surface"
                app:badge_drawable="@drawable/ic_appblock_logo_accent"
                app:badge_elevation="@dimen/button_elevation"
                app:layout_constraintBottom_toBottomOf="@+id/hintSwitch"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/hintSwitch"/>
            <TextView
                android:id="@+id/textView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:layout_marginStart="@dimen/activity_horizontal_margin"
                app:layout_constraintBottom_toTopOf="@+id/subtitleTextView"
                app:layout_constraintEnd_toStartOf="@+id/hintSwitch"
                app:layout_constraintStart_toEndOf="@+id/iconView"
                app:layout_constraintTop_toTopOf="@+id/iconView"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/AppTheme.TextView.H5"/>
            <TextView
                android:id="@+id/subtitleTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/allow"
                android:layout_marginStart="@dimen/activity_horizontal_margin"
                app:layout_constraintBottom_toBottomOf="@+id/iconView"
                app:layout_constraintEnd_toStartOf="@+id/hintSwitch"
                app:layout_constraintStart_toEndOf="@+id/iconView"
                app:layout_constraintTop_toBottomOf="@+id/textView"
                style="@style/AppTheme.TextView.Body2.Secondary"/>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/hintSwitch"
                android:padding="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/activity_horizontal_margin"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/textView"
                app:layout_constraintTop_toBottomOf="@+id/hintTextView"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
    <ImageView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/tapImageView"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-16dp"
        android:contentDescription="@string/select"
        app:srcCompat="@drawable/ic_tap"/>
</FrameLayout>

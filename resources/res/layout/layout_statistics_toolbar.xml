<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.appbar.MaterialToolbar xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/statisticsToolbar"
    android:padding="12dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/AppTheme.Toolbar.Surface">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <Spinner
            android:gravity="center"
            android:layout_gravity="end"
            android:id="@+id/weekDaySpinner"
            android:background="@drawable/background_rounded_surface"
            android:padding="5dp"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foreground="?attr/selectableItemBackground"
            android:minHeight="@dimen/statistics_spinner_height"
            android:elevation="@dimen/button_elevation"
            android:overlapAnchor="false"
            android:layout_marginHorizontal="5dp"/>
        <Spinner
            android:gravity="center"
            android:layout_gravity="start"
            android:id="@+id/timeUsagesSpinner"
            android:background="@drawable/background_rounded_surface"
            android:padding="5dp"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foreground="?attr/selectableItemBackground"
            android:minHeight="@dimen/statistics_spinner_height"
            android:elevation="@dimen/button_elevation"
            android:overlapAnchor="false"
            android:outlineProvider="background"
            android:layout_marginHorizontal="5dp"/>
    </LinearLayout>
</com.google.android.material.appbar.MaterialToolbar>

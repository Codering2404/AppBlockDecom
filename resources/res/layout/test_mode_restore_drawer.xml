<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#0d0f12"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:paddingBottom="32dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#0d0f12"
                android:background="@drawable/test_mode_badge_bg"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TEST MODE"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"/>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <TextView
                android:textSize="20sp"
                android:textColor="#ffffff"
                android:id="@+id/close_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✕"/>
        </LinearLayout>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Simulate Restore"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#b3ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Select the entitlements to restore for this test session."/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/entitlements_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#b3ffffff"
            android:id="@+id/no_entitlements_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="No entitlements available."/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/sw_cyan"
            android:gravity="center"
            android:id="@+id/restore_button"
            android:background="@drawable/test_mode_button_bg"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Restore"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
        <TextView
            android:textSize="11sp"
            android:textColor="#66ffffff"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="This is a simulated restore. No real transaction will occur."/>
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <cz.mobilesoft.coreblock.view.SwitchCardView
            android:id="@+id/mainSwitch"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
            android:layout_marginVertical="@dimen/cardview_vertical_margin"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="8dp"/>
        <TextView
            android:textAppearance="@style/AppTheme.TextAppearance.Body2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/statistics_settings_disclaimer"
            android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
            android:layout_marginVertical="@dimen/cardview_vertical_margin"
            android:paddingHorizontal="16dp"/>
        <cz.mobilesoft.coreblock.view.TwoRowSwitch
            android:id="@+id/appStatisticsSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:subTitleText="@string/settings_app_statistics_description"
            app:titleText="@string/settings_app_statistics_title"
            style="@style/AppTheme.SettingsItem.Switch"/>
        <cz.mobilesoft.coreblock.view.TwoRowSwitch
            android:id="@+id/browsingStatisticsSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:subTitleText="@string/settings_browsing_statistics_description"
            app:titleText="@string/settings_browsing_statistics_title"
            style="@style/AppTheme.SettingsItem.Switch"/>
        <cz.mobilesoft.coreblock.view.TwoRowSwitch
            android:id="@+id/incognitoStatisticsSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:subTitleText="@string/settings_incognito_statistics_description"
            app:titleText="@string/settings_incognito_statistics_title"
            style="@style/AppTheme.SettingsItem.Switch"/>
        <View
            android:background="@color/main_light"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="@dimen/cardview_vertical_margin"/>
        <TextView
            android:textAppearance="@style/AppTheme.TextAppearance.H6"
            android:textColor="@color/main_secondary"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dashboard_card"
            android:textAllCaps="true"
            android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
            android:layout_marginVertical="@dimen/cardview_vertical_margin"
            android:paddingHorizontal="16dp"/>
        <cz.mobilesoft.coreblock.scene.more.settings.SettingsItemView
            android:id="@+id/timePeriodItem"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:titleText="@string/statistics_dashboard_card_time_filter"
            style="@style/AppTheme.SettingsItem"/>
        <cz.mobilesoft.coreblock.scene.more.settings.SettingsItemView
            android:id="@+id/usageTypeItem"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:titleText="@string/statistics_dashboard_card_usage_type_filter"
            style="@style/AppTheme.SettingsItem"/>
        <cz.mobilesoft.coreblock.scene.more.settings.SettingsItemView
            android:id="@+id/displayStatisticsItem"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:titleText="@string/statistics_dashboard_card_apps_webs_filter"
            style="@style/AppTheme.SettingsItem"/>
    </LinearLayout>
</ScrollView>

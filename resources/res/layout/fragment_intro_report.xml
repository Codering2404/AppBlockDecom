<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true">
            <cz.mobilesoft.coreblock.view.GradientTextView
                android:id="@+id/titleTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="60dp"
                android:text="@string/intro_report_title"
                android:textAlignment="center"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.7"
                style="@style/AppTheme.TextView.IntroHeading"/>
            <TextView
                android:id="@+id/descriptionTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/intro_report_description"
                android:textAlignment="center"
                app:layout_constraintBottom_toTopOf="@+id/progressBar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/titleTextView"
                app:layout_constraintVertical_bias="0"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_constraintWidth_percent="0.7"
                style="@style/AppTheme.TextView.IntroBody"/>
            <antonkozyriatskyi.circularprogressindicator.CircularProgressIndicator
                android:id="@+id/progressBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:minWidth="172dp"
                app:direction="clockwise"
                app:drawDot="false"
                app:enableProgressAnimation="true"
                app:layout_constraintBottom_toTopOf="@+id/guessTextView"
                app:layout_constraintDimensionRatio="w,1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/descriptionTextView"
                app:layout_constraintWidth_max="256dp"
                app:layout_constraintWidth_min="172dp"
                app:layout_constraintWidth_percent="0.5"
                app:progressBackgroundColor="@color/main_light"
                app:progressBackgroundStrokeWidth="3dp"
                app:progressCap="butt"
                app:progressColor="@color/accent"
                app:progressStrokeWidth="6dp"
                app:textColor="@android:color/transparent"/>
            <TextView
                android:textSize="32sp"
                android:textColor="@color/critical"
                android:gravity="center"
                android:id="@+id/averageTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/hoursTextView"
                app:layout_constraintEnd_toEndOf="@+id/progressBar"
                app:layout_constraintStart_toStartOf="@+id/progressBar"
                app:layout_constraintTop_toTopOf="@+id/progressBar"
                app:layout_constraintVertical_bias="0.53"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/AppTheme.TextView.H1"/>
            <TextView
                android:gravity="center"
                android:id="@+id/hoursTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/progressBar"
                app:layout_constraintEnd_toEndOf="@+id/progressBar"
                app:layout_constraintStart_toStartOf="@+id/progressBar"
                app:layout_constraintTop_toBottomOf="@+id/averageTextView"
                style="@style/AppTheme.TextView.Body1.Secondary"/>
            <TextView
                android:textColor="@color/accent"
                android:gravity="center"
                android:id="@+id/percentTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/progressBar"
                app:layout_constraintEnd_toEndOf="@+id/progressBar"
                app:layout_constraintStart_toStartOf="@+id/progressBar"
                app:layout_constraintTop_toTopOf="@+id/progressBar"
                app:layout_constraintVertical_bias="0.48"
                style="@style/AppTheme.TextView.H1"/>
            <cz.mobilesoft.coreblock.view.GradientTextView
                android:textColor="@color/accent"
                android:id="@+id/analyzingTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/analyzing"
                android:textAlignment="center"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/progressBar"
                app:layout_constraintWidth_percent="0.7"
                style="@style/AppTheme.TextView.H3"/>
            <TextView
                android:id="@+id/progressTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/intro_report_being_prepared"
                android:textAlignment="center"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/analyzingTextView"
                app:layout_constraintWidth_percent="0.7"
                style="@style/AppTheme.TextView.Body1"/>
            <TextView
                android:id="@+id/guessTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textAlignment="center"
                android:layout_marginStart="@dimen/activity_horizontal_margin"
                android:layout_marginEnd="@dimen/activity_horizontal_margin"
                app:layout_constraintBottom_toTopOf="@+id/graphContainer"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/progressBar"
                style="@style/AppTheme.TextView.Body1"/>
            <FrameLayout
                android:id="@+id/graphContainer"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_marginTop="12dp"
                app:layout_constraintBottom_toTopOf="@+id/worstDayTextView"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/guessTextView"/>
            <TextView
                android:id="@+id/worstDayTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textAlignment="center"
                android:layout_marginStart="@dimen/activity_horizontal_margin"
                android:layout_marginEnd="@dimen/activity_horizontal_margin"
                app:layout_constraintBottom_toTopOf="@+id/subtitleTextView"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/graphContainer"
                style="@style/AppTheme.TextView.Body1"/>
            <cz.mobilesoft.coreblock.view.GradientTextView
                android:id="@+id/subtitleTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/intro_report_subtitle"
                android:textAlignment="center"
                app:layout_constraintBottom_toTopOf="@+id/recyclerView"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/worstDayTextView"
                app:layout_constraintWidth_percent="0.7"
                style="@style/AppTheme.TextView.H3"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false"
                app:layout_constraintBottom_toTopOf="@+id/unlocksTitleTextView"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/subtitleTextView"
                app:layout_goneMarginBottom="112dp"/>
            <cz.mobilesoft.coreblock.view.GradientTextView
                android:id="@+id/unlocksTitleTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/intro_report_unlocks_title"
                android:textAlignment="center"
                app:layout_constraintBottom_toTopOf="@+id/unlocksTextView"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/recyclerView"
                app:layout_constraintWidth_percent="0.7"
                style="@style/AppTheme.TextView.H3"/>
            <TextView
                android:textSize="50sp"
                android:textColor="@color/critical"
                android:gravity="center"
                android:id="@+id/unlocksTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintBottom_toTopOf="@+id/unlocksGuessTextView"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/unlocksTitleTextView"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/AppTheme.TextView.H1"/>
            <TextView
                android:id="@+id/unlocksGuessTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="112dp"
                android:textAlignment="center"
                android:layout_marginStart="@dimen/activity_horizontal_margin"
                android:layout_marginEnd="@dimen/activity_horizontal_margin"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/unlocksTextView"
                style="@style/AppTheme.TextView.Body1"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/progressGroup"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:constraint_referenced_ids="percentTextView,analyzingTextView,progressTextView"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/titleGroup"
                android:visibility="invisible"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:constraint_referenced_ids="titleTextView,descriptionTextView"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/contentGroup"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:constraint_referenced_ids="averageTextView,hoursTextView,graphContainer,worstDayTextView,guessTextView,subtitleTextView,recyclerView"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/unlocksGroup"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:constraint_referenced_ids="unlocksTextView,unlocksTitleTextView,unlocksGuessTextView"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <include
        android:layout_gravity="bottom"
        android:id="@+id/bottomLayout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/view_bottom_button"/>
</FrameLayout>

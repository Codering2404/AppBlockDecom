<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="top"
    android:background="@color/black_85_alpha"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/closeButton"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_close_accent"
        app:tint="@color/main_secondary"/>
    <ImageView
        android:id="@+id/iconImageView"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:alpha="0.8"
        android:layout_marginStart="40dp"
        app:layout_constraintBottom_toBottomOf="@+id/lockedImageView"
        app:layout_constraintStart_toStartOf="@+id/lockedImageView"
        app:layout_constraintTop_toTopOf="@+id/lockedImageView"/>
    <cz.mobilesoft.coreblock.view.badge.BadgeView
        android:id="@+id/lockedImageView"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp"
        android:layout_marginStart="@dimen/activity_horizontal_margin"
        app:badge_background="@color/white"
        app:badge_drawable="@drawable/ic_appblock_logo"
        app:badge_elevation="6dp"
        app:badge_padding="-2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/white"
        android:gravity="center_horizontal"
        android:id="@+id/titleTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="32dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/descriptionTextView"
        app:layout_constraintStart_toEndOf="@+id/iconImageView"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/AppTheme.TextView.H3"/>
    <TextView
        android:textColor="@color/white_90_alpha"
        android:id="@+id/descriptionTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:layout_marginEnd="@dimen/activity_horizontal_margin"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/titleTextView"
        app:layout_constraintTop_toBottomOf="@+id/titleTextView"
        style="@style/AppTheme.TextView.Body1"/>
</androidx.constraintlayout.widget.ConstraintLayout>

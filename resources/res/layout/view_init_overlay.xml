<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#010d22"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:fitsSystemWindows="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/activity_vertical_margin">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="360dp"
            android:layout_height="360dp"
            android:src="@drawable/app_icon_with_background_gradient"
            android:contentDescription=""/>
        <TextView
            android:textColor="@color/white"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/android_initialize_lock_screen_text"
            android:textAlignment="center"
            android:paddingHorizontal="@dimen/activity_horizontal_margin"
            style="@style/AppTheme.TextAppearance.H2"/>
        <TextView
            android:textColor="@color/secondary_button_title"
            android:layout_gravity="center"
            android:paddingTop="@dimen/activity_vertical_margin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/android_initialize_lock_screen_description"
            android:textAlignment="center"
            android:paddingHorizontal="@dimen/activity_horizontal_margin"
            style="@style/AppTheme.TextAppearance.Body2"/>
        <ProgressBar
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/accent"/>
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:paddingStart="@dimen/screen_side_padding"
    android:paddingEnd="@dimen/screen_side_padding">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/activity_horizontal_margin"
        android:paddingEnd="@dimen/activity_horizontal_margin">
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/emptyViewContainer"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/img_error"
                android:maxHeight="@dimen/img_error_max_height"
                android:contentDescription="@string/profile_error_card_title"/>
            <Button
                android:textStyle="bold"
                android:id="@+id/tryAgainButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:text="@string/retry"
                style="@style/AppTheme.AccentButton"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/contentLayout"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textColor="@color/critical"
                android:id="@+id/titleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/restore_purchase_4_title"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                style="@style/AppTheme.TextView.H4"/>
            <TextView
                android:id="@+id/descriptionTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:text="@string/gpa_check_description"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                style="@style/AppTheme.TextView.Body1"/>
            <EditText
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:textColorHint="@color/main_disabled"
                android:id="@+id/gpaEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="GPA.1234-1234-1234-12345"
                android:maxLength="24"
                android:digits="gpaGPA1234567890.-"
                android:inputType="text"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:importantForAutofill="no"/>
            <cz.mobilesoft.coreblock.view.MaterialProgressButton
                android:enabled="false"
                android:id="@+id/restoreButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/restore"
                style="@style/AppTheme.AccentButton"/>
            <TextView
                android:textColorLink="@color/accent"
                android:autoLink="email"
                android:linksClickable="false"
                android:id="@+id/disclaimerTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                style="@style/AppTheme.TextView.Body2"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/errorContainer"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/errorImageView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="9dp"
                android:src="@drawable/img_error"
                android:adjustViewBounds="true"
                android:maxHeight="@dimen/img_error_max_height"
                android:contentDescription="@string/profile_error_card_title"
                app:layout_constraintBottom_toTopOf="@+id/errorTextView"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.45"
                app:layout_constraintVertical_chainStyle="packed"/>
            <TextView
                android:gravity="center"
                android:id="@+id/errorTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:text="@string/restore_purchase_failed_description"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                app:layout_constraintBottom_toTopOf="@+id/contactSupportButton"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/errorImageView"
                style="@style/AppTheme.TextView.Body1.Secondary"/>
            <Button
                android:textStyle="bold"
                android:id="@+id/contactSupportButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/contact_support"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/AppTheme.AccentButton"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</androidx.core.widget.NestedScrollView>

<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/contentCard"
    android:duplicateParentState="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="0dp"
    android:foreground="?android:attr/selectableItemBackground"
    style="@style/AppTheme.BorderedCardView">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:duplicateParentState="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="24dp">
        <ImageView
            android:id="@+id/iconImageView"
            android:background="@drawable/quick_block_step_icon_background"
            android:padding="8dp"
            android:duplicateParentState="true"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/icon"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"/>
        <TextView
            android:textColor="@color/quick_block_step_number_text_color"
            android:gravity="center"
            android:id="@+id/numberTextView"
            android:duplicateParentState="true"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/iconImageView"
            app:layout_constraintEnd_toEndOf="@+id/iconImageView"
            app:layout_constraintStart_toStartOf="@+id/iconImageView"
            app:layout_constraintTop_toTopOf="@+id/iconImageView"
            style="@style/AppTheme.TextAppearance.H3"/>
        <TextView
            android:textColor="@color/quick_block_step_title_text_color"
            android:id="@+id/titleTextView"
            android:duplicateParentState="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@+id/chevronImageView"
            app:layout_constraintStart_toEndOf="@+id/iconImageView"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/AppTheme.TextView.H5"/>
        <TextView
            android:textColor="@color/quick_block_step_subtitle_text_color"
            android:id="@+id/subtitleTextView"
            android:duplicateParentState="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintEnd_toEndOf="@+id/titleTextView"
            app:layout_constraintStart_toStartOf="@+id/titleTextView"
            app:layout_constraintTop_toBottomOf="@+id/titleTextView"
            style="@style/AppTheme.TextView.Body2"/>
        <ImageView
            android:id="@+id/chevronImageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/select"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_chevron_right_24dp"
            app:tint="@color/accent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>

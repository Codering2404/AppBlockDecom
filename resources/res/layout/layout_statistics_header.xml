<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/container"
    android:paddingTop="10dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true">
    <LinearLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageButton
            android:id="@+id/leftArrowButton"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="@dimen/statistics_spinner_height"
            android:layout_height="@dimen/statistics_spinner_height"
            android:src="@drawable/ic_previous_circle"
            android:elevation="@dimen/button_elevation"
            android:outlineProvider="bounds"/>
        <TextView
            android:gravity="center"
            android:id="@+id/intervalTitleTextView"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="200dp"
            android:elevation="@dimen/button_elevation"
            style="@style/AppTheme.TextView.Body2.Secondary"/>
        <ImageButton
            android:id="@+id/rightArrowButton"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="@dimen/statistics_spinner_height"
            android:layout_height="@dimen/statistics_spinner_height"
            android:src="@drawable/ic_next_circle"
            android:elevation="@dimen/button_elevation"
            android:outlineProvider="bounds"/>
    </LinearLayout>
    <TextView
        android:gravity="center"
        android:id="@+id/headerTimeLabelTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:transitionName="@string/transition_description"
        style="@style/AppTheme.TextView.Body2.Secondary"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_gravity="center"
            android:id="@+id/noContentHeaderView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_data"
            style="@style/AppTheme.TextView.Body1.Secondary"/>
        <TextView
            android:textSize="50sp"
            android:textStyle="bold"
            android:textColor="@color/main_secondary"
            android:gravity="center"
            android:id="@+id/headerTimeTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:transitionName="@string/transition_title"/>
    </FrameLayout>
    <TextView
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/headerDifferenceTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:drawablePadding="8dp"
        style="@style/AppTheme.TextView.Body2.Secondary"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/graphViewPager"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:transitionName="@string/transition_image"/>
</LinearLayout>

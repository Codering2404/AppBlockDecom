<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingTop="20dp"
        android:paddingRight="24dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/descriptionTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/location_schedule_disclaimer_description"
            android:drawablePadding="16dp"
            app:drawableStartCompat="@drawable/ic_newprofile_location"
            style="@style/AppTheme.TextView.Body1"/>
        <CheckBox
            android:id="@+id/neverShowAgainCheckBox"
            android:paddingLeft="4dp"
            android:paddingRight="8dp"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginLeft="8dp"
            android:text="@string/never_show_again"
            style="@style/AppTheme.TextView.Body2.Secondary"/>
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/background_bottomsheet"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RadioGroup
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/radioGroup"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <RadioButton
                android:gravity="center"
                android:id="@+id/dailyButton"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="96dp"
                android:text="@string/title_daily"
                android:textAllCaps="false"
                style="@style/AppTheme.RadioButton.OnSurface"/>
            <RadioButton
                android:gravity="center"
                android:id="@+id/hourlyButton"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="96dp"
                android:text="@string/title_hourly"
                android:lines="1"
                android:layout_weight="1"
                android:textAllCaps="false"
                style="@style/AppTheme.RadioButton.OnSurface"/>
        </RadioGroup>
        <TextView
            android:gravity="center"
            android:id="@+id/currentTimeTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/AppTheme.TextView.H6.Secondary"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="radioGroup,currentTimeTextView"/>
        <ImageView
            android:id="@+id/lockImageView"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/lock_profile_until"
            android:layout_marginStart="@dimen/activity_horizontal_margin"
            app:layout_constraintBottom_toBottomOf="@+id/selectedTimeLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/selectedTimeLayout"
            app:srcCompat="@drawable/ic_lock_open_secondary"
            style="@style/Base.Widget.AppCompat.ActionButton"/>
        <TextView
            android:textSize="24sp"
            android:id="@+id/plusTextView"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="+"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/selectedTimeLayout"
            app:layout_constraintEnd_toStartOf="@+id/selectedTimeLayout"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toEndOf="@+id/lockImageView"
            style="@style/AppTheme.TextView.Body1"/>
        <TextView
            android:textColor="@color/critical"
            android:gravity="center"
            android:id="@+id/previousTimeTextView"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrier"
            style="@style/AppTheme.TextView.H4"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/selectedTimeLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@+id/backspaceButton"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/lockImageView"
            app:layout_constraintTop_toBottomOf="@+id/previousTimeTextView"
            app:layout_goneMarginTop="8dp">
            <TextView
                android:textSize="36sp"
                android:textColor="@color/main_disabled_on_surface"
                android:id="@+id/hoursTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <View
                android:id="@+id/hoursMinutesDivider"
                android:layout_width="16dp"
                android:layout_height="0dp"/>
            <TextView
                android:textSize="36sp"
                android:textColor="@color/main_disabled_on_surface"
                android:id="@+id/minutesTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/backspaceButton"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/go_back"
            android:layout_marginEnd="@dimen/activity_horizontal_margin"
            app:layout_constraintBottom_toBottomOf="@+id/selectedTimeLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/selectedTimeLayout"
            app:srcCompat="@drawable/ic_backspace_24dp"
            style="@style/Base.Widget.AppCompat.ActionButton"/>
        <View
            android:id="@+id/view"
            android:background="?android:attr/listDivider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/selectedTimeLayout"
            app:layout_goneMarginTop="24dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/buttonRow0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:weightSum="3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view">
            <Button
                android:textAppearance="@style/AppTheme.TextAppearance.H1"
                android:textColor="@color/accent"
                android:tag="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="1"
                android:layout_weight="1"
                app:cornerRadius="@dimen/button_radius"
                style="@style/AppTheme.BorderlessButton"/>
            <Button
                android:textAppearance="@style/AppTheme.TextAppearance.H1"
                android:textColor="@color/accent"
                android:tag="2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="2"
                android:layout_weight="1"
                app:cornerRadius="@dimen/button_radius"
                style="@style/AppTheme.BorderlessButton"/>
            <Button
                android:textAppearance="@style/AppTheme.TextAppearance.H1"
                android:textColor="@color/accent"
                android:tag="3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="3"
                android:layout_weight="1"
                app:cornerRadius="@dimen/button_radius"
                style="@style/AppTheme.BorderlessButton"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/buttonRow1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:weightSum="3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/buttonRow0">
            <Button
                android:textAppearance="@style/AppTheme.TextAppearance.H1"
                android:textColor="@color/accent"
                android:tag="4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="4"
                android:layout_weight="1"
                app:cornerRadius="@dimen/button_radius"
                style="@style/AppTheme.BorderlessButton"/>
            <Button
                android:textAppearance="@style/AppTheme.TextAppearance.H1"
                android:textColor="@color/accent"
                android:tag="5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="5"
                android:layout_weight="1"
                app:cornerRadius="@dimen/button_radius"
                style="@style/AppTheme.BorderlessButton"/>
            <Button
                android:textAppearance="@style/AppTheme.TextAppearance.H1"
                android:textColor="@color/accent"
                android:tag="6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="6"
                android:layout_weight="1"
                app:cornerRadius="@dimen/button_radius"
                style="@style/AppTheme.BorderlessButton"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/buttonRow2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:weightSum="3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/buttonRow1">
            <Button
                android:textAppearance="@style/AppTheme.TextAppearance.H1"
                android:textColor="@color/accent"
                android:tag="7"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="7"
                android:layout_weight="1"
                app:cornerRadius="@dimen/button_radius"
                style="@style/AppTheme.BorderlessButton"/>
            <Button
                android:textAppearance="@style/AppTheme.TextAppearance.H1"
                android:textColor="@color/accent"
                android:tag="8"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="8"
                android:layout_weight="1"
                app:cornerRadius="@dimen/button_radius"
                style="@style/AppTheme.BorderlessButton"/>
            <Button
                android:textAppearance="@style/AppTheme.TextAppearance.H1"
                android:textColor="@color/accent"
                android:tag="9"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="9"
                android:layout_weight="1"
                app:cornerRadius="@dimen/button_radius"
                style="@style/AppTheme.BorderlessButton"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/buttonRow3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:weightSum="3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/buttonRow2">
            <Button
                android:textAppearance="@style/AppTheme.TextAppearance.H2"
                android:textColor="@color/accent"
                android:id="@+id/plus1h"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="+1h"
                android:layout_weight="1"
                app:cornerRadius="@dimen/button_radius"
                style="@style/AppTheme.BorderlessButton"/>
            <Button
                android:textAppearance="@style/AppTheme.TextAppearance.H1"
                android:textColor="@color/accent"
                android:tag="0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="0"
                android:layout_weight="1"
                app:cornerRadius="@dimen/button_radius"
                style="@style/AppTheme.BorderlessButton"/>
            <Button
                android:textAppearance="@style/AppTheme.TextAppearance.H2"
                android:textColor="@color/accent"
                android:id="@+id/plus5m"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="+5m"
                android:layout_weight="1"
                app:cornerRadius="@dimen/button_radius"
                style="@style/AppTheme.BorderlessButton"/>
        </LinearLayout>
        <include
            android:id="@+id/bottomLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/buttonRow3"
            layout="@layout/view_bottom_button"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>

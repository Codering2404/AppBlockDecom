<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:duplicateParentState="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/text_color_main_enabled_appearance"
        android:id="@+id/titleTextView"
        android:duplicateParentState="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        style="@style/AppTheme.TextView.H5"/>
    <TextView
        android:id="@+id/subtitleTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        style="@style/AppTheme.TextView.Body2.Secondary"/>
    <TextView
        android:textColor="@color/text_color_accent_enabled_appearance"
        android:ellipsize="end"
        android:id="@+id/valueTextView"
        android:duplicateParentState="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        style="@style/AppTheme.TextView.H6"/>
</LinearLayout>

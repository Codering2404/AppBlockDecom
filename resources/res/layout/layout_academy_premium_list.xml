<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="16dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <TextView
        android:gravity="center"
        android:id="@+id/titleTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/sm_hint_4_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/AppTheme.TextView.Body1.Secondary"/>
    <ImageView
        android:id="@+id/feature1Badge"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@string/icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/feature1TextView"
        app:srcCompat="@drawable/ic_check_accent_small"
        app:tint="@color/premium"/>
    <TextView
        android:id="@+id/feature1TextView"
        android:paddingTop="2dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toTopOf="@+id/feature2TextView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/feature1Badge"
        app:layout_constraintTop_toBottomOf="@+id/titleTextView"
        app:layout_constraintVertical_bias="0.4"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/AppTheme.TextView.Body1"/>
    <ImageView
        android:id="@+id/feature2Badge"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@string/icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/feature2TextView"
        app:srcCompat="@drawable/ic_check_accent_small"
        app:tint="@color/premium"/>
    <TextView
        android:id="@+id/feature2TextView"
        android:paddingTop="2dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toTopOf="@+id/feature3TextView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/feature2Badge"
        app:layout_constraintTop_toBottomOf="@+id/feature1TextView"
        style="@style/AppTheme.TextView.Body1"/>
    <ImageView
        android:id="@+id/feature3Badge"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@string/icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/feature3TextView"
        app:srcCompat="@drawable/ic_check_accent_small"
        app:tint="@color/premium"/>
    <TextView
        android:id="@+id/feature3TextView"
        android:paddingTop="2dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toTopOf="@+id/feature4TextView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/feature3Badge"
        app:layout_constraintTop_toBottomOf="@+id/feature2TextView"
        style="@style/AppTheme.TextView.Body1"/>
    <ImageView
        android:id="@+id/feature4Badge"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@string/icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/feature4TextView"
        app:srcCompat="@drawable/ic_check_accent_small"
        app:tint="@color/premium"/>
    <TextView
        android:id="@+id/feature4TextView"
        android:paddingTop="2dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/feature4Badge"
        app:layout_constraintTop_toBottomOf="@+id/feature3TextView"
        style="@style/AppTheme.TextView.Body1"/>
</androidx.constraintlayout.widget.ConstraintLayout>

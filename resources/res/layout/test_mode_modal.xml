<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/sw_grey"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="28dp"
        android:paddingBottom="32dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <TextView
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✏️ Test Mode Active"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#b3ffffff"
            android:gravity="center"
            android:id="@+id/reason_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#b3ffffff"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="All purchases will be simulated and product data will be retrieved from the Superwall dashboard."/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/sw_cyan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="User ID"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#ffffff"
                    android:id="@+id/view_dashboard_button"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#ffffff"
                    android:id="@+id/copy_user_id_button"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Copy"
                    android:paddingStart="12dp"
                    android:paddingEnd="0dp"/>
            </LinearLayout>
            <TextView
                android:textSize="15sp"
                android:textColor="#ffffff"
                android:id="@+id/user_id_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"/>
        </LinearLayout>
        <View
            android:background="#1affffff"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/sw_cyan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Purchase Controller"/>
            <TextView
                android:textSize="15sp"
                android:textColor="#ffffff"
                android:id="@+id/purchase_controller_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"/>
        </LinearLayout>
        <View
            android:background="#1affffff"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/device_attributes_row"
            android:background="?android:attr/selectableItemBackground"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/sw_cyan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Device Attributes"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tap to view"/>
            </LinearLayout>
            <TextView
                android:textSize="24sp"
                android:textColor="@color/sw_cyan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"/>
        </LinearLayout>
        <View
            android:background="#1affffff"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/user_attributes_row"
            android:background="?android:attr/selectableItemBackground"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/sw_cyan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User Attributes"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tap to view"/>
            </LinearLayout>
            <TextView
                android:textSize="24sp"
                android:textColor="@color/sw_cyan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"/>
        </LinearLayout>
        <View
            android:background="#1affffff"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/sw_cyan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Free Trial Override"
                    android:layout_weight="1"/>
                <Spinner
                    android:id="@+id/free_trial_spinner"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"/>
            </LinearLayout>
            <TextView
                android:textSize="13sp"
                android:textColor="#ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Override free trial availability"/>
        </LinearLayout>
        <View
            android:background="#1affffff"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/entitlements_section"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/sw_cyan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Starting Entitlements"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Select the state of existing entitlements:"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/entitlements_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/sw_cyan"
            android:gravity="center"
            android:id="@+id/continue_button"
            android:background="@drawable/test_mode_button_bg"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Continue"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
        <TextView
            android:textSize="11sp"
            android:textColor="#66ffffff"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Configure test mode users in your Superwall Dashboard."/>
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/moreButton"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/more"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_more_white"
            app:tint="@color/white_75_alpha"
            style="@style/Base.Widget.AppCompat.ActionButton"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/blockingReasonButton"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/more"
            app:layout_constraintEnd_toStartOf="@+id/moreButton"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_help_outline"
            app:tint="@color/white_75_alpha"
            style="@style/Base.Widget.AppCompat.ActionButton"/>
        <ImageView
            android:id="@+id/iconImageView"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@string/app"
            android:alpha="0.8"
            app:layout_constraintBottom_toBottomOf="@+id/overlayView"
            app:layout_constraintEnd_toEndOf="@+id/overlayView"
            app:layout_constraintStart_toStartOf="@+id/overlayView"
            app:layout_constraintTop_toTopOf="@+id/overlayView"/>
        <ImageView
            android:id="@+id/overlayView"
            android:layout_width="144dp"
            android:layout_height="144dp"
            android:src="@drawable/ic_circle_critical_32dp"
            android:contentDescription="@string/icon"
            android:alpha="0.4"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:layout_constraintBottom_toTopOf="@+id/appNameTextView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <cz.mobilesoft.coreblock.view.badge.BadgeView
            android:id="@+id/lockedImageView"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="8dp"
            app:badge_background="@color/white"
            app:badge_drawable="@drawable/ic_appblock_logo_accent"
            app:badge_elevation="6dp"
            app:badge_padding="-2dp"
            app:layout_constraintStart_toStartOf="@+id/overlayView"
            app:layout_constraintTop_toTopOf="@+id/overlayView"/>
        <TextView
            android:textColor="@color/white"
            android:gravity="center_horizontal"
            android:id="@+id/appNameTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
            app:layout_constraintBottom_toTopOf="@+id/blockingProfileTextView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/overlayView"
            style="@style/AppTheme.TextView.H3"/>
        <TextView
            android:textColor="@color/white_75_alpha"
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:id="@+id/blockingProfileTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
            app:layout_constraintBottom_toTopOf="@+id/blockUntilTextView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/appNameTextView"
            style="@style/AppTheme.TextView.Body1"/>
        <TextView
            android:textColor="@color/white_75_alpha"
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:id="@+id/blockUntilTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
            app:layout_constraintBottom_toTopOf="@+id/explanationTitleTextView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/blockingProfileTextView"
            style="@style/AppTheme.TextView.H5"/>
        <TextView
            android:textColor="@color/white_75_alpha"
            android:gravity="center"
            android:id="@+id/explanationTitleTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/blocking_count_title"
            android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
            app:layout_constraintBottom_toTopOf="@+id/explanationTextView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/blockUntilTextView"
            style="@style/AppTheme.TextView.Body1"/>
        <TextView
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/explanationTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
            app:layout_constraintBottom_toTopOf="@+id/motivationalTextView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/explanationTitleTextView"
            style="@style/AppTheme.TextView.H4"/>
        <TextView
            android:textStyle="italic"
            android:textColor="@color/white_75_alpha"
            android:gravity="center"
            android:id="@+id/motivationalTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/app_block_be_productive"
            android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
            app:layout_constraintBottom_toTopOf="@+id/settingsButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/explanationTextView"
            style="@style/AppTheme.TextView.Body2"/>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/fitifyCardView"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="@dimen/activity_horizontal_margin_large"
            android:layout_marginEnd="@dimen/activity_horizontal_margin_large"
            app:cardCornerRadius="@dimen/cardview_radius"
            app:layout_constraintBottom_toTopOf="@+id/settingsButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/explanationTextView"
            app:layout_constraintVertical_bias="1">
            <LinearLayout
                android:orientation="horizontal"
                android:background="@drawable/background_fitify"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_fitify"
                    android:contentDescription="@string/icon"/>
                <TextView
                    android:textColor="@color/white"
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/fitifyTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    style="@style/AppTheme.TextView.Body1"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/vosHealthCardView"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="@dimen/activity_horizontal_margin_large"
            android:layout_marginEnd="@dimen/activity_horizontal_margin_large"
            app:cardCornerRadius="@dimen/cardview_radius"
            app:layout_constraintBottom_toTopOf="@+id/settingsButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/explanationTextView"
            app:layout_constraintVertical_bias="1">
            <LinearLayout
                android:orientation="horizontal"
                android:background="@drawable/background_vos_health_gradient"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_gravity="start|center_vertical"
                    android:background="@drawable/background_rounded_white"
                    android:padding="8dp"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_vos_health"
                    android:contentDescription="@string/icon"/>
                <TextView
                    android:textColor="@color/white"
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/vosHealthTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    style="@style/AppTheme.TextView.Body1"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/campaignCardView"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="@dimen/activity_horizontal_margin_large"
            android:layout_marginEnd="@dimen/activity_horizontal_margin_large"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/cardview_radius"
            app:layout_constraintBottom_toTopOf="@+id/settingsButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/explanationTextView"
            app:layout_constraintVertical_bias="1"
            app:rippleColor="@color/black_20_alpha">
            <com.google.android.material.textview.MaterialTextView
                android:textColor="@color/black"
                android:gravity="start|center_vertical"
                android:id="@+id/campaignTextView"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="16dp"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_gift_56dp"
                app:drawableStartCompat="@drawable/ic_gift_56dp"
                style="@style/AppTheme.TextView.Body2"/>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/inAppUpdateCardView"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="@dimen/activity_horizontal_margin_large"
            android:layout_marginEnd="@dimen/activity_horizontal_margin_large"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/cardview_radius"
            app:layout_constraintBottom_toTopOf="@+id/settingsButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/explanationTextView"
            app:layout_constraintVertical_bias="1"
            app:rippleColor="@color/black_20_alpha">
            <com.google.android.material.textview.MaterialTextView
                android:textColor="@color/black"
                android:gravity="start|center_vertical"
                android:id="@+id/inAppUpdateTextView"
                android:background="?android:attr/selectableItemBackground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_update_available_title"
                android:drawablePadding="16dp"
                android:drawableStart="@drawable/ic_appblock_logo_accent_32dp"
                android:drawableEnd="@drawable/ic_chevron_right_24dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                app:drawableTint="@color/accent"
                style="@style/AppTheme.TextView.H5"/>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton
            android:textAppearance="@style/AppTheme.TextAppearance.H4"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/settingsButton"
            android:padding="16dp"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/available_settings"
            app:icon="@drawable/ic_settings_outline_24dp"
            app:iconPadding="8dp"
            app:iconTint="@color/white"
            app:layout_constraintBottom_toTopOf="@+id/closeButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_goneMarginBottom="60dp"
            app:rippleColor="@color/white_25_alpha"
            style="@style/AppTheme.BorderlessButton"/>
        <com.google.android.material.button.MaterialButton
            android:textAppearance="@style/AppTheme.TextAppearance.H4"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/closeButton"
            android:focusable="true"
            android:visibility="invisible"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/close"
            android:paddingHorizontal="48dp"
            app:layout_constraintBottom_toTopOf="@+id/advertisementFrameLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_goneMarginBottom="60dp"
            app:rippleColor="@color/white_25_alpha"
            style="@style/AppTheme.AccentButton"/>
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progressIndicator"
            android:padding="16dp"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="100"
            android:foregroundTint="@color/accent"
            app:indicatorSize="48dp"
            app:layout_constraintBottom_toTopOf="@+id/advertisementFrameLayout"
            app:layout_constraintEnd_toStartOf="@+id/closeButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_goneMarginBottom="60dp"
            app:showText="true"
            app:textColor="@color/accent"/>
        <TextView
            android:textAppearance="@style/AppTheme.TextAppearance.H5"
            android:textColor="@color/accent"
            android:id="@+id/progressTextView"
            android:padding="16dp"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            app:layout_constraintBottom_toBottomOf="@+id/progressIndicator"
            app:layout_constraintEnd_toEndOf="@+id/progressIndicator"
            app:layout_constraintStart_toStartOf="@+id/progressIndicator"
            app:layout_constraintTop_toTopOf="@+id/progressIndicator"
            app:layout_goneMarginBottom="60dp"/>
        <com.google.android.material.button.MaterialButton
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/backToAppButton"
            android:padding="16dp"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toTopOf="@+id/advertisementFrameLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_goneMarginBottom="60dp"
            app:rippleColor="@color/white_25_alpha"
            style="@style/AppTheme.AccentButton"/>
        <FrameLayout
            android:gravity="bottom"
            android:id="@+id/advertisementFrameLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:animateLayoutChanges="true">
    <CheckedTextView
        android:id="@+id/hintCheckedTextView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:minHeight="30dp"
        android:drawablePadding="20dp"
        android:paddingStart="4dp"
        app:drawableStartCompat="@drawable/ic_faq"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintHeight_min="wrap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/AppTheme.HintCheckBox"/>
    <TextView
        android:autoLink="none"
        android:id="@+id/hintTextView"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="50dp"
        app:layout_constraintBottom_toTopOf="@+id/premiumButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hintCheckedTextView"
        style="@style/AppTheme.TextView.Caption"/>
    <Button
        android:id="@+id/premiumButton"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:minHeight="0dp"
        android:text="@string/get_premium"
        app:icon="@drawable/ic_premium_diamond"
        app:iconGravity="textStart"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/hintTextView"
        app:layout_constraintTop_toBottomOf="@+id/hintTextView"
        style="@style/AppTheme.PremiumAccentButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>

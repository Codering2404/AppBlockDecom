<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/background_bottomsheet_surface"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/activity_horizontal_margin">
        <TextView
            android:paddingTop="26dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_activity_setting"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            style="@style/AppTheme.TextView.H5.Secondary"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/quick_block_blocking_level_description"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            style="@style/AppTheme.TextView.Body2.Secondary"/>
        <cz.mobilesoft.coreblock.view.TwoRowSwitch
            android:id="@+id/blockLaunchSwitch"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            app:errorImageRes="@drawable/ic_error_filled_24dp"
            app:icon="@drawable/ic_apps_off_24dp"
            app:iconPadding="24dp"
            app:titleText="@string/title_launch"/>
        <cz.mobilesoft.coreblock.view.TwoRowSwitch
            android:id="@+id/blockNotificationsSwitch"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            app:errorImageRes="@drawable/ic_error_filled_24dp"
            app:icon="@drawable/ic_notification_off_24dp"
            app:iconPadding="24dp"
            app:titleText="@string/title_notifications"
            style="@style/AppTheme.Switch.OnSurface"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="30dp"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

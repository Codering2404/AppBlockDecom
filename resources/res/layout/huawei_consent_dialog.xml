<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:overScrollMode="never">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/mainLayout"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/headerLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/appLogoImageView"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginHorizontal="4dp"
                    app:srcCompat="@drawable/ic_appblock_logo"/>
                <TextView
                    android:id="@+id/appNameTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:layout_marginHorizontal="4dp"/>
            </LinearLayout>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/main"
                android:id="@+id/textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/we_care_about_privacy_description"
                android:textAlignment="center"
                app:layout_constraintTop_toBottomOf="@+id/headerLayout"
                style="@style/AppTheme.TextView.H6"/>
            <TextView
                android:id="@+id/textView2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/continue_to_use_data_question"
                android:textAlignment="center"
                app:layout_constraintTop_toBottomOf="@+id/textView"
                style="@style/AppTheme.TextView.H5"/>
            <TextView
                android:textSize="11sp"
                android:id="@+id/consentChoiceDescriptionTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/can_change_choice_of_usage_data_description"
                android:textAlignment="center"
                app:layout_constraintTop_toBottomOf="@+id/textView2"
                style="@style/AppTheme.TextView.Body2"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/critical"
                android:id="@+id/partnersLinkTextView"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/app_and_partners_data_usage"
                android:textAlignment="center"
                app:layout_constraintTop_toBottomOf="@+id/consentChoiceDescriptionTextView"
                style="@style/AppTheme.TextView.Body2"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/partnersLayout"
            android:padding="16dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/partnersHeaderLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/partnersAppLogoImageView"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginHorizontal="4dp"
                    app:srcCompat="@drawable/ic_appblock_logo"/>
                <TextView
                    android:id="@+id/partnersAppNameTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:layout_marginHorizontal="4dp"/>
            </LinearLayout>
            <TextView
                android:textSize="11sp"
                android:id="@+id/partnersUsageDataDescriptionTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/partners_usage_data_description"
                android:textAlignment="center"
                app:layout_constraintTop_toBottomOf="@+id/partnersHeaderLayout"
                style="@style/AppTheme.TextView.Body2"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/providersRecyclerView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="8dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/partnersUsageDataDescriptionTextView"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/critical"
                android:id="@+id/privacyPolicyTextView"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/app_usage_data_description"
                android:textAlignment="center"
                app:layout_constraintTop_toBottomOf="@+id/providersRecyclerView"
                style="@style/AppTheme.TextView.Body2"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/contentLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/statisticsToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/layout_statistics_toolbar"/>
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="16dp"
            android:animateLayoutChanges="true">
            <include
                android:id="@+id/statisticsHeaderView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                layout="@layout/layout_statistics_header"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/appsWebsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>
            <View
                android:id="@+id/divider"
                android:background="@color/main_light_on_surface"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"/>
            <TextView
                android:id="@+id/blockedByTextView"
                android:paddingTop="22dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/activity_horizontal_margin"
                android:paddingEnd="@dimen/activity_horizontal_margin"
                style="@style/AppTheme.TextView.Body1.Secondary"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/cardsContainer"
                android:paddingTop="@dimen/cardview_vertical_margin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <Button
                android:id="@+id/addToBlockingButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/activity_horizontal_margin"
                android:layout_marginTop="16dp"
                android:layout_marginRight="@dimen/activity_horizontal_margin"
                android:text="@string/add_to_blocking"
                style="@style/AppTheme.SurfaceButton"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/appWebRow"
    android:background="?attr/selectableItemBackground"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/screen_side_padding"
    android:paddingEnd="@dimen/screen_side_padding">
    <cz.mobilesoft.coreblock.view.badge.BadgeView
        android:id="@android:id/icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="@dimen/activity_horizontal_margin"
        app:badge_background="@color/background_badge"
        app:badge_drawable="@drawable/ic_appblock_logo"
        app:badge_elevation="@dimen/button_elevation"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/nameTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/AppTheme.TextView.H5"/>
        </LinearLayout>
        <TextView
            android:textColor="@color/critical"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/appWebTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            style="@style/AppTheme.TextView.Body2"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/clearButton"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/activity_horizontal_margin"
        app:srcCompat="@drawable/ic_close_accent"
        app:tint="@color/main_secondary"/>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/statisticsToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/layout_statistics_toolbar"/>
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:animateLayoutChanges="true">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include
                    android:id="@+id/statisticsHeaderView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    layout="@layout/layout_statistics_header"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/disabledStatisticsView"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <androidx.constraintlayout.widget.Guideline
                        android:orientation="vertical"
                        android:id="@+id/imageViewGuideline"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:layout_constraintGuide_percent="0.2"/>
                    <ImageView
                        android:id="@+id/disabledStatisticsImageView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:scaleType="centerCrop"
                        android:adjustViewBounds="true"
                        android:maxWidth="210dp"
                        android:contentDescription="@null"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="1"
                        app:layout_constraintStart_toStartOf="@+id/imageViewGuideline"
                        app:layout_constraintWidth_max="wrap"
                        app:layout_constraintWidth_percent="0.5"
                        app:srcCompat="@drawable/img_graph"/>
                    <TextView
                        android:id="@+id/disabledStatisticsTitleTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/statistics_usage_access_explanation_title"
                        android:layout_marginStart="16dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="packed"
                        style="@style/AppTheme.TextView.H2"/>
                    <TextView
                        android:id="@+id/disabledStatisticsDescriptionTextView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/disabled_statistics_description"
                        android:layout_marginEnd="16dp"
                        app:layout_constraintEnd_toEndOf="@+id/disabledStatisticsViewGuide"
                        app:layout_constraintStart_toStartOf="@+id/disabledStatisticsTitleTextView"
                        app:layout_constraintTop_toBottomOf="@+id/disabledStatisticsTitleTextView"
                        style="@style/AppTheme.TextView.Body2.Secondary"/>
                    <View
                        android:id="@+id/disabledStatisticsViewGuide"
                        android:layout_width="1dp"
                        android:layout_height="0dp"
                        app:layout_constraintEnd_toEndOf="@+id/disabledStatisticsImageView"
                        app:layout_constraintStart_toStartOf="@+id/disabledStatisticsImageView"
                        app:layout_constraintTop_toTopOf="@+id/disabledStatisticsImageView"/>
                    <TextView
                        android:textColor="@color/accent"
                        android:gravity="center_horizontal"
                        android:id="@+id/disabledStatisticsSettingsTextView"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="16dp"
                        android:text="@string/open_settings"
                        app:layout_constraintStart_toStartOf="@+id/disabledStatisticsDescriptionTextView"
                        app:layout_constraintTop_toBottomOf="@+id/disabledStatisticsDescriptionTextView"
                        style="@style/AppTheme.TextView.H5"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </FrameLayout>
            <RadioGroup
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/radioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp">
                <RadioButton
                    android:id="@+id/allButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/all"
                    style="@style/AppTheme.RadioButton.OnSurface"/>
                <RadioButton
                    android:id="@+id/appsButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/apps"
                    style="@style/AppTheme.RadioButton.OnSurface"/>
                <RadioButton
                    android:id="@+id/websButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/webs"
                    style="@style/AppTheme.RadioButton.OnSurface"/>
            </RadioGroup>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/appsWebsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
